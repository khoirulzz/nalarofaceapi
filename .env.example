# Environment variables required by Nalaro Face API
# Copy this to .env and fill in the values. NEVER commit .env to Git.

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Paste the full JSON content of your Firebase service account key.
# Generate at: Firebase Console → Project Settings → Service accounts → Generate new private key
# Paste as a single-line JSON string (use `jq -c .` to compact it).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── JWT Shared Secret ────────────────────────────────────────────────────────
# Must be at least 32 characters. Use the same value in the Cloudflare Worker.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FACE_API_SECRET=change_me_to_a_random_64_char_hex_string

# ─── Matching threshold (optional, default 0.72) ──────────────────────────────
# Cosine similarity threshold. Higher = stricter. Calibrate after real-device testing.
# Recommended range: 0.68 – 0.80
FACE_MATCH_THRESHOLD=0.72

# ─── Token TTL in seconds (optional, default 60) ─────────────────────────────
# How long the verification JWT is valid. Must be long enough for one round-trip.
FACE_TOKEN_TTL=60

# ─── CORS allowed origins (optional) ─────────────────────────────────────────
# Comma-separated list. Defaults include Pages domains and localhost.
ALLOWED_ORIGINS=https://nalaroclass.pages.dev,https://class.nalaro.digital,https://nalaro.web.id,http://localhost:5173

# ─── Enable API docs UI (optional, disabled by default) ──────────────────────
# Set to 1 only in development. Never enable in production.
ENABLE_DOCS=0

